{
  "name": "etc-passenger",
  "version": "1.0.0",
  "private": true,
  "description": "Enugu Transit Control passenger app + Coal City Chat - Capacitor (Android)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/build-offline.js",
    "build:offline": "node scripts/build-offline.js",
    "localize": "node scripts/localize-remote.js",
    "android:patch": "node scripts/patch-android.js",
    "android:patch:play": "node scripts/patch-android.js --play-store",
    "sync": "node scripts/build-offline.js && cap sync android",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor-community/sqlite": "^8.0.0",
    "etc-device-files": "file:./plugins/etc-device-files",
    "firebase": "10.13.2",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "dexie": "3.2.7",
    "jspdf": "2.5.1",
    "leaflet": "1.9.4",
    "qrcodejs": "1.0.0",
    "etc-alarm": "file:./plugins/etc-alarm"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "tailwindcss": "3.4.17"
  }
}
