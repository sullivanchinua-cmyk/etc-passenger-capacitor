{
  "appId": "enugubustransit.com",
  "appName": "Enugu Smart Bus",
  "webDir": "www",
  "backgroundColor": "#DCDDE0",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "LocalNotifications": {
      "iconColor": "#1A237E",
      "smallIcon": "ic_stat_etc"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "android": {
    "backgroundColor": "#DCDDE0",
    "allowMixedContent": false
  }
}
