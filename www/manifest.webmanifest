      "src": "screenshots/bus-promo.jpg",
      "sizes": "679x575",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Modern electric bus fleet – Enugu Smart Bus"
    }
  ],
  "shortcuts": [
    {
      "name": "Book a trip",
      "short_name": "Book",
      "description": "Search routes and book seats",
      "url": "/?action=book",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My tickets",
      "short_name": "Tickets",
      "description": "View booked tickets and QR codes",
      "url": "/ticket.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Chat support",
      "short_name": "Chat",
      "description": "Message ETC support",
      "url": "/chat/",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Notifications",
      "short_name": "Alerts",
      "description": "Ticket and trip alerts",
      "url": "/notifications.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "related_applications": [],
